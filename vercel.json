{
  "buildCommand": "node scripts/inject-tracking.mjs",
  "framework": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "env": {
    "GA_MEASUREMENT_ID": "G-TDFWJELM5B",
    "META_PIXEL_ID": "",
    "GTM_CONTAINER_ID": ""
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "akshaya-milan.vercel.app" }],
      "destination": "https://www.akshayamilan.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "akshayamilan.com" }],
      "destination": "https://www.akshayamilan.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "akshaya-milan.vercel.app" }],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    }
  ]
}
