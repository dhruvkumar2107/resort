# ---------------------------------------------------------------------------
# Akshaya Milan — environment variables
# Copy to `.env.local` for `vercel dev` or set in the Vercel dashboard
# (Settings -> Environment Variables). NEVER commit real values.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://yourproject.supabase.co
SUPABASE_URL=

# Supabase SERVICE ROLE key (server-only secret). Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase anon/publishable key (optional; used only for optional edge verification).
SUPABASE_ANON_KEY=

# Secret token required to run the one-time admin bootstrap (POST /api/auth/setup).
# Generate a long random value, e.g. `openssl rand -hex 32`.
ADMIN_BOOTSTRAP_TOKEN=

# Analytics retention window in days. Records older than this are purged by the
# admin "Settings" retention control. Default: 180.
ANALYTICS_RETENTION_DAYS=180

# Canonical base URL used for links/emails.
SITE_URL=https://www.akshayamilan.com